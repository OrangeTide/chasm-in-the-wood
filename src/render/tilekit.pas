unit tilekit;

{** Baked meshes for the tiles, grouped by environment.

  Each tile is an authored voxel model loaded from baseDir/<env>/<kind>.vox when that
  file is present, and a placeholder generated by formula (see prims) when it is not: a
  floor plate, a wall plate, a door arch, a door-leaf plate, and a flight of steps for
  stairs. So authored art drops in per environment and kind, one file at a time, and the
  rest stay procedural until their files land. Each tile is baked from the file's z-up
  into the engine's y-up and meshed to a single GPU mesh; the world draws a cell by
  drawing its environment-and-kind mesh at the cell origin.

  Each mesh records its footprint and the caller scales it to fill one world cell, by
  TILE / footprint, so a tile of any voxel count fills the cell. The pitch for authored
  tiles is 96 voxels to one tile (one 264-unit kit module, so one voxel is 2.75 kit
  units): every dungeon tile is authored on a 96-voxel footprint so a voxel is the same
  physical size tile to tile and features line up across the seams. The generated
  placeholders are coarser (TILE_FOOT voxels) and are replaced as authored tiles land. }

{$mode objfpc}{$H+}

interface

uses
  sysutils, voxfile, voxmesh, gpumesh, prims;

type
  TTileEnv  = (teDungeon, teForest, teTown);
  TTileKind = (tkFloor, tkWall, tkDoor, tkDoorLeaf, tkStairUp, tkStairDn);

  TTileMesh = record
    Gpu:    TGpuMesh;
    Loaded: Boolean;
    Sx, Sy, Sz: LongInt;    { baked voxel dimensions, y up }
  end;

const
  TILE_GRID = 96;   { the pitch: a full authored tile is 96 voxels (one 264-unit module) }
  TILE_MAXH = 256;  { height clamp: the .vox per-axis maximum, so nothing truncates }
  TILE_FOOT = 16;   { placeholder resolution: generated tiles are coarse, fitted to a cell }
  TILE_WALLH = 40;  { generated wall and door height: well above the one-tile floor }
  TILE_STEPH = 30;  { generated stair height, so the steps climb clear of the floor }

{ Load and mesh every environment's tiles under baseDir (e.g. 'content/tiles'): each is
  the authored baseDir/<env>/<kind>.vox when present, else a generated placeholder. Needs
  a live GL context. Always succeeds, since every kind has a generated fallback. }
function TileKitLoad(const baseDir: String): Boolean;

{ The baked mesh for an environment and kind. }
function TileKitMesh(env: TTileEnv; kind: TTileKind): TTileMesh;

procedure TileKitFree;

implementation

const
  { The directory per environment and the filename stem per kind, under baseDir. }
  ENV_DIR: array[TTileEnv] of String = ('dungeon', 'forest', 'town');
  KIND_FILE: array[TTileKind] of String =
    ('floor', 'wall', 'door', 'doorleaf', 'stairup', 'stairdn');

var
  gKits: array[TTileEnv, TTileKind] of TTileMesh;

procedure BakeYUp(const src: TVoxModel; out dst: TVoxModel);
{ Rotate a z-up model into y-up (height along y), clamped to the grid. The source voxel
  (x, depth, height) becomes the baked voxel (x, height, depth). }
var
  nx, ny, nz, x, y, z: LongInt;
  v: Byte;
begin
  nx := src.Sx; if nx > TILE_GRID then nx := TILE_GRID;
  nz := src.Sy; if nz > TILE_GRID then nz := TILE_GRID;
  ny := src.Sz; if ny > TILE_MAXH then ny := TILE_MAXH;
  VoxAlloc(dst, nx, ny, nz);
  for z := 0 to nz - 1 do
    for y := 0 to ny - 1 do
      for x := 0 to nx - 1 do begin
        v := VoxCell(src, x, z, y);
        if v <> 0 then VoxSetCell(dst, x, y, z, v);
      end;
  dst.Palette := src.Palette;
end;

procedure MeshFrom(const src: TVoxModel; env: TTileEnv; kind: TTileKind);
{ Bake a z-up prim into y-up, mesh it, and store it as this env and kind's tile. }
var
  baked: TVoxModel;
  mesh: TVoxMesh;
begin
  BakeYUp(src, baked);
  BuildMesh(baked, mesh);
  GpuMeshUpload(gKits[env, kind].Gpu, mesh);
  gKits[env, kind].Sx := baked.Sx;
  gKits[env, kind].Sy := baked.Sy;
  gKits[env, kind].Sz := baked.Sz;
  gKits[env, kind].Loaded := True;
end;

function TileKitLoad(const baseDir: String): Boolean;
{ For each environment and kind, use the authored baseDir/<env>/<kind>.vox when it loads,
  else a generated placeholder: a floor is a plate one tile tall (its top at the world
  floor height), a wall a taller plate, a door an arch, a door-leaf a plate filling the
  frame, and the stairs a short flight of steps. The placeholders are coarse (TILE_FOOT
  voxels); the caller scales any footprint to the cell, so an authored tile need only
  match the 96-voxel pitch (TILE_GRID) to share a voxel size across the dungeon. }
var
  env: TTileEnv;
  kind: TTileKind;
  floorP, wallP, doorP, leafP, stepP, authored: TVoxModel;
  path: String;
  nAuthored: LongInt;

  function PrimFor(k: TTileKind): TVoxModel;
  begin
    case k of
      tkWall:               PrimFor := wallP;
      tkDoor:               PrimFor := doorP;
      tkDoorLeaf:           PrimFor := leafP;
      tkStairUp, tkStairDn: PrimFor := stepP;
    else                    PrimFor := floorP;
    end;
  end;

begin
  for env := Low(TTileEnv) to High(TTileEnv) do
    for kind := Low(TTileKind) to High(TTileKind) do
      gKits[env, kind].Loaded := False;

  PrimPlate(floorP, TILE_FOOT, TILE_FOOT, TILE_FOOT);
  PrimPlate(wallP,  TILE_FOOT, TILE_FOOT, TILE_WALLH);
  PrimArch(doorP,   TILE_FOOT, TILE_FOOT, TILE_WALLH);
  PrimPlate(leafP,  TILE_FOOT, TILE_FOOT, TILE_WALLH);   { a shut door-leaf }
  PrimSteps(stepP,  TILE_FOOT, TILE_FOOT, TILE_STEPH, 5);

  nAuthored := 0;
  for env := Low(TTileEnv) to High(TTileEnv) do
    for kind := Low(TTileKind) to High(TTileKind) do begin
      path := baseDir + '/' + ENV_DIR[env] + '/' + KIND_FILE[kind] + '.vox';
      if FileExists(path) and VoxLoad(path, authored) then begin
        MeshFrom(authored, env, kind);
        Inc(nAuthored);
      end else
        MeshFrom(PrimFor(kind), env, kind);
    end;

  if nAuthored > 0 then
    writeln('tilekit: ', nAuthored, ' authored tiles, the rest generated')
  else
    writeln('tilekit: all tiles generated (no authored tiles under ', baseDir, ')');
  TileKitLoad := True;
end;

function TileKitMesh(env: TTileEnv; kind: TTileKind): TTileMesh;
begin
  if gKits[env, kind].Loaded then
    TileKitMesh := gKits[env, kind]
  else
    TileKitMesh := gKits[env, tkFloor];   { should not happen: every kind is built }
end;

procedure TileKitFree;
var
  env: TTileEnv;
  kind: TTileKind;
begin
  for env := Low(TTileEnv) to High(TTileEnv) do
    for kind := Low(TTileKind) to High(TTileKind) do
      if gKits[env, kind].Loaded then begin
        GpuMeshFree(gKits[env, kind].Gpu);
        gKits[env, kind].Loaded := False;
      end;
end;

end.
