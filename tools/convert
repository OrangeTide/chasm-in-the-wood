#!/bin/sh
# Mechanical voxel asset converter. See docs/asset-pipeline.md.
#
# Reads tools/kits.txt (the global voxel size and each kit's units-to-metres scale) and a
# manifest, and for every asset runs the source mesh through assimp (when it is not already
# an OBJ) and then the voxelizer, at the one physical voxel size the kit implies. No
# per-asset resolution: units-per-voxel is voxel / scale, derived per kit.
#
# Usage: tools/convert [manifest]            (default: tools/assets.txt)
#   ASSET_ROOT  base directory the manifest sources are relative to (default: .)
#   VOXELIZE    the voxelizer binary (default: build/tools/voxelize)
#
# Manifest lines (blank lines and lines beginning with # are ignored):
#   asset <kit> <source> <output.vox> [surface] [offset=vx,vy,vz] [cell] [celloff=ox,oy] [cellfill] [scale=f]
#     kit       a name from tools/kits.txt
#     source    a mesh (.fbx/.gltf/.glb via assimp, or .obj used directly), under ASSET_ROOT
#     output    where to write the .vox
#     surface   keep the bare surface instead of filling the interior (grates, foliage)
#     offset    per-axis sampling phase in voxel fractions (e.g. offset=0.5,0,0.5)
#     cell      slice a kit module down to one cell tile
#     celloff   which cell of the module to take (voxel origin ox,oy)
#     cellfill  extrude a thin face panel through the cell depth into a solid block
#     scale     per-asset multiplier on the kit scale, for a pack not internally to scale
#               (a bigger factor makes a bigger, finer-sampled model)

set -eu
here=$(CDPATH= cd "$(dirname "$0")" && pwd)
kits="$here/kits.txt"
manifest="${1:-$here/assets.txt}"
root="${ASSET_ROOT:-.}"
voxelize="${VOXELIZE:-$here/../build/tools/voxelize}"
pose="${POSE:-$here/../build/tools/pose}"
glb2glb="${GLTF2GLB:-$here/../build/tools/gltf2glb}"

[ -f "$kits" ]     || { echo "convert: no kit table at $kits" >&2; exit 1; }
[ -f "$manifest" ] || { echo "convert: no manifest at $manifest" >&2; exit 1; }
[ -x "$voxelize" ] || { echo "convert: build the voxelizer first (make tools): $voxelize" >&2; exit 1; }

voxel=$(awk '$1=="voxel"{print $2}' "$kits")
[ -n "$voxel" ] || { echo "convert: no 'voxel' line in $kits" >&2; exit 1; }
cell=$(awk '$1=="cell"{print $2}' "$kits")
cellvox=""
[ -n "$cell" ] && cellvox=$(awk -v c="$cell" -v v="$voxel" 'BEGIN{printf "%d", c/v + 0.5}')

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# Strip comments and blank lines so the loop runs in this shell, not a pipe subshell.
grep -vE '^[[:space:]]*(#|$)' "$manifest" > "$tmp/m" || true

n=0
while read -r tag kit src out rest; do
    # A rigged character: pack the glTF to a glb, pose it at an animation clip, then
    # voxelize the posed OBJ. Fields: pose <kit> <gltf> <animlib.glb> <clip> <time> <out.vox>
    if [ "${tag:-}" = pose ]; then
        [ -x "$pose" ] || { echo "convert: build the tools first: $pose" >&2; exit 1; }
        [ -x "$glb2glb" ] || { echo "convert: build the tools first: $glb2glb" >&2; exit 1; }
        animlib=$out
        # shellcheck disable=SC2086
        set -- $rest
        clip=$1; ptime=$2; pout=$3
        [ -n "$pout" ] || { echo "convert: malformed pose line for $src" >&2; exit 1; }
        kitline=$(awk -v k="$kit" '$1=="kit" && $2==k {print; exit}' "$kits")
        [ -n "$kitline" ] || { echo "convert: unknown kit '$kit' for $src" >&2; exit 1; }
        scale=$(echo "$kitline" | awk '{print $3}')
        vu=$(awk -v v="$voxel" -v s="$scale" 'BEGIN{printf "%.6f", v/s}')
        in="$root/$src"
        [ -f "$in" ] || { echo "convert: missing source $in" >&2; exit 1; }
        base=$(basename "$in"); base=${base%.*}
        glb="$(dirname "$in")/$base.glb"
        obj="$(dirname "$in")/$base.posed.obj"
        # Make a self-contained glb from the source: a .gltf is packed with its .bin, an
        # .fbx (the animated creature kits) goes through assimp, a .glb is used as is.
        case "$in" in
            *.glb|*.GLB) glb="$in" ;;
            *.gltf|*.GLTF) "$glb2glb" "$in" "$glb" >/dev/null 2>&1 \
                || { echo "convert: gltf2glb failed on $in" >&2; exit 1; } ;;
            *) assimp export "$in" "$glb" >/dev/null 2>&1 \
                || { echo "convert: assimp failed on $in" >&2; exit 1; } ;;
        esac
        # animlib `self` poses the model with its own embedded clips (the self-animated
        # creature rigs); otherwise a separate library (the human UAL) is retargeted in.
        if [ "$animlib" = self ]; then
            animglb="$glb"
        else
            animglb="$root/$animlib"
            [ -f "$animglb" ] || { echo "convert: missing anim library $animglb" >&2; exit 1; }
        fi
        "$pose" "$glb" "$obj" "$animglb" "$clip" "$ptime" >/dev/null 2>&1 \
            || { echo "convert: pose failed on $in ($clip)" >&2; exit 1; }
        mkdir -p "$(dirname "$pout")"
        printf '  %-26s %-9s %s u/vox  pose %s@%ss\n' "$(basename "$pout")" "$kit" "$vu" \
            "$clip" "$ptime"
        "$voxelize" "$obj" "$pout" --voxel "$vu" --offset 0.5,0,0.5 >/dev/null
        n=$((n + 1))
        continue
    fi
    [ "${tag:-}" = asset ] || continue
    kitline=$(awk -v k="$kit" '$1=="kit" && $2==k {print; exit}' "$kits")
    [ -n "$kitline" ] || { echo "convert: unknown kit '$kit' for $src" >&2; exit 1; }
    scale=$(echo "$kitline" | awk '{print $3}')
    vu=$(awk -v v="$voxel" -v s="$scale" 'BEGIN{printf "%.6f", v/s}')
    up=""
    for w in $kitline; do
        case "$w" in up=*) up="--up ${w#up=}" ;; esac
    done

    surface=""; offset=""; cellarg=""; scalef=""
    for w in ${rest:-}; do
        case "$w" in
            surface)   surface=surface ;;
            offset=*)  offset="--offset ${w#offset=}" ;;
            cell)      [ -n "$cellvox" ] || { echo "convert: no 'cell' line in $kits" >&2; exit 1; }
                       cellarg="--cell $cellvox" ;;
            celloff=*) cellarg="$cellarg --celloff ${w#celloff=}" ;;
            cellfill)  cellarg="$cellarg --cellfill" ;;
            scale=*)   scalef="${w#scale=}" ;;
            *) echo "convert: unknown flag '$w' on $src" >&2; exit 1 ;;
        esac
    done
    # A per-asset scale factor multiplies the kit scale for this one asset, for a kit that
    # is not internally to scale (a creature pack whose models differ in native size). A
    # bigger factor means a bigger model: it shrinks units-per-voxel, so the mesh spans
    # more voxels. The kit scale stays the shared default; this only tunes the outliers.
    if [ -n "$scalef" ]; then
        vu=$(awk -v u="$vu" -v f="$scalef" 'BEGIN{printf "%.6f", u/f}')
    fi

    in="$root/$src"
    [ -f "$in" ] || { echo "convert: missing source $in" >&2; exit 1; }
    case "$src" in
        *.obj|*.OBJ) obj="$in" ;;
        *) obj="$tmp/conv.obj"
           assimp export "$in" "$obj" >/dev/null 2>&1 \
               || { echo "convert: assimp failed on $in" >&2; exit 1; } ;;
    esac

    mkdir -p "$(dirname "$out")"
    printf '  %-26s %-9s %s u/vox%s%s%s%s\n' "$(basename "$out")" "$kit" "$vu" \
        "${up:+  $up}" "${cellarg:+  $cellarg}" "${surface:+  surface}" "${offset:+  $offset}"
    "$voxelize" "$obj" "$out" --voxel "$vu" $up $cellarg $surface $offset >/dev/null
    n=$((n + 1))
done < "$tmp/m"

echo "convert: $n assets written"
